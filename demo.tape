# Запись демо-гифки: vhs demo.tape
# Перед записью соберите бинарник:  g++ -O3 main.cpp -o tty3d
Output demo.gif

Set FontSize 14
Set Width 1200
Set Height 720
Set Padding 10

Type "./tty3d --color amber -m knot"
Enter
Sleep 6s
Type "n"
Sleep 3s
Type "s"
Sleep 3s
Type "c"
Sleep 3s
Type "q"
Sleep 500ms
